# ==============================================================================
# Git Ignore Configuration - Sales Analytics Dashboard
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions & build distribution
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
.conda/

# Streamlit secrets & local credentials
.streamlit/secrets.toml
.streamlit/credentials.toml

# Environment variables, credentials & private keys
.env
.env.*
*.pem
*.key
*.cert
*.pfx
id_rsa
id_ed25519

# Testing, coverage & linting caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# IDE & Editor settings
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Operating system artifacts
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Temporary runtime uploads, logs & exports
data/uploads/
temp/
exports/
*.tmp
*.log

# Explicit whitelisting of sample data, assets, and config
!data/samples/
!data/samples/*
!assets/
!assets/*
!.streamlit/config.toml
!README.md
